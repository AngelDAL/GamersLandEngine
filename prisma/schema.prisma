generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}
enum Role {
  ADMIN
  ORGANIZER
  PLAYER
  SPONSOR
  EXPOSITOR
  EJECUTIVO
}

enum BracketType {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  SWISS
}

enum TournamentStatus {
  DRAFT
  OPEN_REGISTRATION
  CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
  REQUEST
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum RoundStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ChatRoomType {
  TOURNAMENT
  MATCH
  TEAM
}

enum PlayerMatchResult {
  WON
  LOST
  DRAW
  DNP
}

enum TeamMatchResultEnum {
  WON
  LOST
  DRAW
  FORFEIT
}

enum PrizeType {
  POSITION
  PARTICIPATION
  SPONSOR_GIFT
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String?  @unique
  passwordHash   String?
  emailVerified  DateTime?
  verificationToken String?
  resetToken        String?
  resetTokenExpires DateTime?
  role           Role     @default(PLAYER)
  adminPassword  String?
  qrCode         String?
  avatarUrl      String?
  createdAt      DateTime @default(now())

  riotGameName           String?   // "Quieto"
  riotTagLine            String?   // "Compadre"
  riotRegion             String?   // platform code, e.g. "la1"
  riotPuuid              String?   @unique
  riotSummonerId         String?
  riotIconId             Int?      // profile icon id
  riotLinkedAt           DateTime?
  riotProfileRefreshedAt DateTime?
  riotSkinSeed           Int?      // sticky random seed for splash art

  memberships              TeamMember[]
  registrations            TournamentRegistration[]
  createdTournaments       Tournament[]             @relation("TournamentCreator")
  organizedTournaments     TournamentOrganizer[]
  sentMessages             ChatMessage[]
  ownedTeams               Team[]                   @relation("TeamCaptain")
  matchResults             MatchResult[]
  claimedPrizes            PrizeClaim[]
  sponsorPrizes            Prize[]                  @relation("SponsorPrizes")
  clerkClaims              PrizeClaim[]             @relation("ClerkClaims")
  notifications            Notification[]
  playerMatchHistory     PlayerMatchHistory[]
}

model RiotCache {
  key       String   @id
  value     String   @db.LongText
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model PlayerMatchHistory {
  id                  String    @id @default(cuid())

  userId              String?
  user                User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  matchId             String
  gameName            String?
  tagLine             String?
  region              String

  queueId             Int
  queueName           String
  gameMode            String
  gameStartTimestamp  DateTime
  gameDurationMin     Int

  championId          Int
  championName        String
  role                String?
  win                 Boolean
  kills               Int
  deaths              Int
  assists             Int
  cs                  Int
  csPerMin            Float
  itemIds             String    @db.LongText
  summoner1Perk       Int?
  summoner2Perk       Int?

  isTournament        Boolean   @default(false)
  tournamentId        String?
  matchGamersLandId   String?
  tournament          Tournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  matchGamersLand     Match?      @relation(fields: [matchGamersLandId], references: [id], onDelete: SetNull)

  createdAt           DateTime  @default(now())

  @@unique([userId, matchId])
  @@index([userId, gameStartTimestamp(sort: Desc)])
  @@index([tournamentId])
  @@index([matchId])
  @@index([isTournament, gameStartTimestamp(sort: Desc)])
}

model Team {
  id        String   @id @default(uuid())
  name      String
  captainId String
  logoUrl   String?
  createdAt DateTime @default(now())

  captain        User              @relation("TeamCaptain", fields: [captainId], references: [id])
  members        TeamMember[]
  participations TournamentTeam[]
  teamResults    TeamMatchResult[]
  registrations  TournamentRegistration[]
  matchWins      Match[]             @relation("MatchWinner")
}

model TeamMember {
  id      String       @id @default(uuid())
  userId  String
  teamId  String
  status  MemberStatus @default(PENDING)
  message String?
  lane    String?      // "TOP", "JUNGLE", "MID", "ADC", "SUPPORT"

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
}

model Tournament {
  id                   String           @id @default(uuid())
  name                 String
  game                 String
  /// Riot platform code (la1, na1, euw1, etc.) — the region this tournament's
  /// Riot matches are played in. Null for non-Riot games.
  region               String?
  description          String?          @db.Text
  entryFee             Decimal?         @default(0)
  maxTeams             Int
  minTeams             Int              @default(4)
  isTeamBased          Boolean          @default(true)
  teamSize             Int              @default(5)
  bracketType          BracketType      @default(SINGLE_ELIMINATION)
  status               TournamentStatus @default(DRAFT)
  eventDate            DateTime
  registrationDeadline DateTime?
  location             String?
  rules                String?          @db.Text
  imageUrl             String?          @db.Text
  createdAt            DateTime         @default(now())
  createdById          String
  riotProviderId       Int?
  riotTournamentId     Int?
  riotMode             String?            @default("stub")

  createdBy      User                    @relation("TournamentCreator", fields: [createdById], references: [id])
  organizers     TournamentOrganizer[]
  registrations  TournamentRegistration[]
  rounds         TournamentRound[]
  prizes         Prize[]
  tournamentTeams TournamentTeam[]
  playerMatchHistory PlayerMatchHistory[]
}

model TournamentOrganizer {
  id           String @id @default(uuid())
  tournamentId String
  userId       String

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
}

model TournamentRegistration {
  id           String             @id @default(uuid())
  tournamentId String
  userId       String
  teamId       String?
  status       RegistrationStatus @default(PENDING)
  paid         Boolean            @default(false)
  checkedInAt  DateTime?
  registeredBy String?
  createdAt    DateTime           @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  user       User       @relation(fields: [userId], references: [id])
  team       Team?      @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, userId])
}

model TournamentTeam {
  id           String @id @default(uuid())
  tournamentId String
  teamId       String
  seed         Int?

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  team       Team       @relation(fields: [teamId], references: [id])

  @@unique([tournamentId, teamId])
}

model TournamentRound {
  id           String      @id @default(uuid())
  tournamentId String
  roundNumber  Int
  status       RoundStatus @default(PENDING)

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  matches    Match[]
}

model Match {
  id              String      @id @default(uuid())
  roundId         String
  team1Id         String?
  team2Id         String?
  winnerId        String?
  score1          Int?
  score2          Int?
  status          MatchStatus @default(PENDING)
  bracketPosition Int?
  notes           String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  log             String?
  /// Riot tournament code assigned to this match. Each match has its own
  /// code that the participating team captains use in the LoL tournament client.
  /// The Riot webhook at /api/riot/callback resolves codes back to matches.
  riotCode        String?

  /// Bracket phase — "UPPER", "LOWER", "FINAL", or "BRACKET_RESET"
  phase           String?             @default("UPPER")

  /// Self-references for bracket advancement.
  /// Winner of this match fills the slot in the next match.
  winnerNextMatchId   String?
  winnerNextMatch     Match?  @relation("WinnerFlow", fields: [winnerNextMatchId], references: [id])
  winnerPrevMatches   Match[] @relation("WinnerFlow")

  /// The winner occupies slot 1 or 2 in the next match (null = final).
  winnerNextSlot      Int?

  /// Loser of this match drops into the next match (double elimination only).
  loserNextMatchId    String?
  loserNextMatch      Match?  @relation("LoserFlow", fields: [loserNextMatchId], references: [id])
  loserPrevMatches    Match[] @relation("LoserFlow")

  /// The loser occupies slot 1 or 2 in the next match (null = final / eliminated).
  loserNextSlot       Int?

  round  TournamentRound @relation(fields: [roundId], references: [id])
  winner Team?           @relation("MatchWinner", fields: [winnerId], references: [id])

  results     MatchResult[]
  teamResults TeamMatchResult[]
  playerMatchHistory PlayerMatchHistory[]

  @@index([riotCode])
  @@index([winnerNextMatchId])
  @@index([loserNextMatchId])
}

model MatchResult {
  id      String            @id @default(uuid())
  matchId String
  userId  String
  teamId  String?
  result  PlayerMatchResult
  score   Int?
  stats   Json?

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

model TeamMatchResult {
  id      String              @id @default(uuid())
  matchId String
  teamId  String
  result  TeamMatchResultEnum
  score   Int?

  match Match @relation(fields: [matchId], references: [id])
  team  Team  @relation(fields: [teamId], references: [id])
}

model Prize {
  id           String    @id @default(uuid())
  tournamentId String
  name         String
  description  String?
  type         PrizeType
  position     Int?
  value        String?
  sponsorId    String?
  imageUrl     String?
  maxClaims    Int?
  createdAt    DateTime  @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id])
  sponsor    User?      @relation("SponsorPrizes", fields: [sponsorId], references: [id])
  claims     PrizeClaim[]
}

model PrizeClaim {
  id        String   @id @default(uuid())
  prizeId   String
  userId    String
  claimedBy String
  notes     String?
  claimedAt DateTime @default(now())

  prize Prize @relation(fields: [prizeId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
  clerk User  @relation("ClerkClaims", fields: [claimedBy], references: [id])

  @@unique([prizeId, userId])
}

model ChatRoom {
  id           String       @id @default(uuid())
  type         ChatRoomType
  matchId      String?      @unique
  tournamentId String?
  teamId       String?      @unique
  createdAt    DateTime     @default(now())

  messages ChatMessage[]
}

model ChatMessage {
  id        String   @id @default(uuid())
  roomId    String
  senderId  String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation(fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  matchId   String?
  read        Boolean  @default(false)
  redirectUrl String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
